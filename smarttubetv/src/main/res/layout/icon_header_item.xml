<?xml version="1.0" encoding="utf-8"?>
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/yttv_nav_item_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/yttv_nav_item_padding_horizontal"
    android:paddingEnd="@dimen/yttv_nav_item_padding_horizontal"
    android:paddingTop="@dimen/yttv_nav_item_padding_vertical"
    android:paddingBottom="@dimen/yttv_nav_item_padding_vertical"
    android:background="@drawable/bg_nav_item">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="@dimen/yttv_nav_icon_size"
        android:layout_height="@dimen/yttv_nav_icon_size"
        android:scaleType="fitCenter"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yttv_nav_icon_margin_end"

        android:singleLine="true"
        android:maxWidth="160dp"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"
        android:textSize="@dimen/yttv_nav_text_size"
        android:fontFamily="sans-serif"

        style="@style/TextAppearance.Leanback.Header"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>
